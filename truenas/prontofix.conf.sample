# Настройки сервера ProntoFix. Файл читает служба при запуске (service prontofix restart).
# Формат строго ИМЯ=значение, по одной переменной в строке, без кавычек и без пробелов вокруг "=".
# Права на файл 600 — он содержит секреты. Храните его копию вместе с резервными копиями!

# Где лежат база, фото/видео и документы (это точка монтирования вашего датасета)
DATA_DIR=/var/db/prontofix
# Папка веб-версии
WEB_DIR=/usr/local/prontofix/web

# Суперпользователь создаётся ОДИН РАЗ при самом первом запуске. Позже пароль меняется командой
#   prontofix-manage reset-password owner
OWNER_USERNAME=owner
OWNER_PASSWORD=@@OWNER_PASSWORD@@

# Ключ подписи входа и шифрования паспортных данных. Потеряете — паспорта не расшифровать, пользователям нужно входить заново.
SECRET_KEY=@@SECRET_KEY@@

# 1 = заказчики могут регистрироваться сами, 0 = только владелец создаёт пользователей
ALLOW_REGISTRATION=1
# Максимальный размер одного фото/видео, МБ
MAX_UPLOAD_MB=200
# Сколько дней действует вход, пока не потребуется ввести пароль заново
TOKEN_DAYS=30

# Карты, которые получает приложение:  google | osm | custom
MAP_PROVIDER=osm
# Ключ Google Map Tiles API (нужен для MAP_PROVIDER=google; без него приложение использует OSM)
GOOGLE_MAPS_KEY=
# Свой сервер тайлов (для MAP_PROVIDER=custom), например https://tiles.example.com/{z}/{x}/{y}.png
CUSTOM_TILE_URL=
